# Configurações do Projeto
PROJECT_NAME="Fique de Olho API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
API_PORT=8000

# Banco de dados publicado pelo docker-compose.yml da raiz
POSTGRES_USER=fique_de_olho
POSTGRES_PASSWORD=fique_de_olho_dev
POSTGRES_DB=fique_de_olho
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pydantic Settings não expande referências ${...}; use a URL completa.
DATABASE_URL=postgresql+psycopg2://fique_de_olho:fique_de_olho_dev@localhost:5432/fique_de_olho

# Autenticação JWT (Issue #63)
JWT_SECRET_KEY="sua-chave-secreta-super-segura-aqui"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
