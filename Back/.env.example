# Configuracoes do Projeto
PROJECT_NAME="Fique de Olho API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
API_PORT=8000

# Banco de dados
POSTGRES_USER=fique_de_olho
POSTGRES_PASSWORD=fique_de_olho_dev
POSTGRES_DB=fique_de_olho
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://fique_de_olho:fique_de_olho_dev@localhost:5432/fique_de_olho

# Autenticacao JWT e Google OAuth
JWT_SECRET_KEY="sua-chave-secreta-super-segura-aqui"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Envio de emails pelo SendGrid
SENDGRID_API_KEY="sua-chave-do-sendgrid"
SENDGRID_FROM_EMAIL="fiquedeolho1011@gmail.com"

# Rotina periódica de notificações
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=3600

# Agendador em segundo plano de coleta periódica de editais (Issue #74)
SCRAPER_SCHEDULER_ENABLED=true
SCRAPER_SCHEDULER_INTERVAL_HOURS=12
SCRAPER_SCHEDULER_RUN_ON_STARTUP=false

# Camada 2 (LLM Google Gemini) para resumos, normalização de títulos e metadados (Issues #77, #106, #121, #129)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_RETRY_DELAY_SECONDS=2.0
